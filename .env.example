HOST=127.0.0.1
PORT=3000
# demo = deterministic local answers; gemma = real Gemini API calls
AI_MODE=demo
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Enable only when testing Wokwi. Public broker traffic is visible to others.
MQTT_ENABLED=false
MQTT_URL=mqtt://broker.hivemq.com:1883
# Choose a unique value and copy it into firmware/wokwi/sketch.ino
MQTT_SESSION=um6p-change-me-2026
# Optional private broker credentials (leave empty for the public demo broker)
MQTT_USERNAME=
MQTT_PASSWORD=
# Publish rendered synthetic JPEG bundles at 1 Hz alongside 5 Hz sensor data
MQTT_PUBLISH_IMAGES=false
# Allow the simulator's warning policy to drive the Wokwi servo over MQTT
MQTT_FORWARD_SIM_HAPTICS=false
# Optional voice API; otherwise browser speech synthesis is used
ELEVENLABS_API_KEY=
# Optional: override the standard voice ID used in ElevenLabs' API examples
ELEVENLABS_VOICE_ID=
# Python multimodal assistant: auto uses Gemma when a key is present, otherwise demo
ASSISTANT_MODE=auto
# GEMMA_API_KEY is an alias for GEMINI_API_KEY; either one is enough
GEMMA_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
PYTHON_ASSISTANT_URL=http://127.0.0.1:8000
STUDIO_URL=http://127.0.0.1:3000

# Immediate vision fallback when Gemma fails; keep the key server-side.
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
