HOST=127.0.0.1
PORT=3000
# demo = deterministic local answers; gemma = real Gemini API calls
AI_MODE=demo
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Enable only when testing Wokwi. Public broker traffic is visible to others.
MQTT_ENABLED=false
MQTT_URL=mqtt://broker.hivemq.com:1883
# Choose a unique value and copy it into firmware/wokwi/sketch.ino
MQTT_SESSION=um6p-change-me-2026
# Optional voice API; otherwise browser speech synthesis is used
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
